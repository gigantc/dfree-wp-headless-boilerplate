# WordPress GraphQL endpoint (no trailing slash on the site URL)
NEXT_PUBLIC_WORDPRESS_URL=https://your-wp-site.local
WORDPRESS_GRAPHQL_ENDPOINT=https://your-wp-site.local/graphql

# Preview auth — a shared secret between the WP mu-plugin and this frontend.
# See README for how to configure the WP side.
WORDPRESS_PREVIEW_SECRET=change-me
